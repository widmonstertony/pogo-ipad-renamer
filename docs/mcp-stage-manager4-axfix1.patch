diff --git a/Makefile.touch-fix b/Makefile.touch-fix
new file mode 100644
--- /dev/null
+++ b/Makefile.touch-fix
@@ -0,0 +1,16 @@
+# Build only the rootless server tweak.  The release package provides the
+# unchanged helpers and preference bundle; this target gives the orientation
+# repair a separately auditable arm64 dylib before it is inserted into the
+# complete official package layout.
+ARCHS = arm64
+TARGET = iphone:clang:latest:15.0
+THEOS_PACKAGE_SCHEME = rootless
+
+include $(THEOS)/makefiles/common.mk
+
+TWEAK_NAME = ios-mcp
+ios-mcp_FILES = Tweak.x MCPServer.m MCPLogger.m HIDManager.m ScreenManager.m ClipboardManager.m AppManager.m AccessibilityManager.m TextInputManager.m FileSystemManager.m LogManager.m OCRManager.m MCPProcessUtil.m MCPAXQueryContext.m MCPAXRemoteContextResolver.m MCPUIElementSerializer.m MCPAXNodeSource.m MCPUIElementsFacade.m MCPAXAttributeBridge.m
+ios-mcp_CFLAGS = -fobjc-arc -Wno-unused-function -Wno-deprecated-declarations -DMCP_ROOTLESS=1 -Icompat
+ios-mcp_FRAMEWORKS = IOKit UIKit CoreGraphics QuartzCore MobileCoreServices AVFoundation Security Vision
+
+include $(THEOS_MAKE_PATH)/tweak.mk
diff --git a/compat/roothide.h b/compat/roothide.h
new file mode 100644
--- /dev/null
+++ b/compat/roothide.h
@@ -0,0 +1,20 @@
+// Build-time compatibility declarations for the rootless target.
+// A rootless bootstrap installs executables under /var/jb. Leaving these
+// paths unchanged silently produces a rootful binary inside an arm64 package.
+#import <Foundation/Foundation.h>
+
+static inline NSString *jbroot(NSString *path) {
+#if defined(MCP_ROOTLESS)
+    if (!path.length || [path isEqualToString:@"/var/jb"] || [path hasPrefix:@"/var/jb/"]) return path ?: @"";
+    return [@"/var/jb" stringByAppendingString:path];
+#else
+    return path ?: @"";
+#endif
+}
+
+static inline NSString *rootfs(NSString *path) {
+#if defined(MCP_ROOTLESS)
+    if ([path hasPrefix:@"/var/jb/"]) return [path substringFromIndex:7];
+#endif
+    return path ?: @"";
+}
