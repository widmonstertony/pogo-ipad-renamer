 }

+// UIScreen.bounds changes when SpringBoard rotates or rearranges a Stage
+// Manager scene.  HID digitizer coordinates are normalised against these
+// values, so caching them only at service startup makes every later touch land
+// at the wrong physical position while the API still reports success.
+- (void)refreshScreenMetrics {
+    dispatch_block_t refreshBlock = ^{
+        UIScreen *screen = [UIScreen mainScreen];
+        CGRect bounds = screen.bounds;
+        CGFloat width = bounds.size.width;
+        CGFloat height = bounds.size.height;
+        if (width < 1.0 || height < 1.0) {
+            HID_LOG(@"Ignoring invalid screen metrics %.2fx%.2f", width, height);
+            return;
+        }
+
+        self->_screenScale = screen.scale;
+        self->_screenWidth = width;
+        self->_screenHeight = height;
+        _deviceScreenWidth = width;
+        _deviceScreenHeight = height;
+        HID_LOG(@"Refreshed screen metrics: %.0fx%.0f @%.0fx", width, height, self->_screenScale);
+    };
+
+    if ([NSThread isMainThread]) {
+        refreshBlock();
+    } else {
+        dispatch_sync(dispatch_get_main_queue(), refreshBlock);
+    }
+}
+
