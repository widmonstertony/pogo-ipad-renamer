# iPhone MCP stays on the trusted LAN. Do not expose it to the public internet.
IPHONE_MCP_URL=http://127.0.0.1:8090/mcp
IPHONE_MCP_HEALTH_URL=http://127.0.0.1:8090/health
IPHONE_MCP_PROTOCOL_VERSION=2025-11-25

# Verify with `list_apps` manually if your installed build uses a different id.
POKEMON_GO_BUNDLE_ID=com.nianticlabs.pokemongo

# Writes are disabled until the read-only rehearsal has been reviewed.
POGO_WRITE_ENABLED=false
POGO_BATCH_LIMIT=20
POGO_OBSERVATION_TTL_SECONDS=20
POGO_JOURNAL_PATH=.pogo-journal/actions.jsonl
